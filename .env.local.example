NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Live site generator (server-only — never expose to the browser).
GENERATOR_URL=https://velxo-site-generator.vercel.app/api/generate
GENERATOR_API_KEY=

# Stripe: deposit-paid webhook -> HighLevel push.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The A$500 deposit Payment Link's id (starts "plink_..."), copied read-only
# from the Stripe Dashboard — NOT the buy.stripe.com URL.
STRIPE_DEPOSIT_PAYMENT_LINK_ID=

# Stripe: subscription Checkout (30-day trial) for the new in-app
# /onboarding flow. Price ids (start "price_..."), copied read-only from the
# Stripe Dashboard — kept as env vars (not hardcoded) so test/live
# environments can differ and price replacement never needs a source change.
# Server-only — never expose either as a NEXT_PUBLIC_ variable.
STRIPE_AI_RECEPTIONIST_PRICE_ID=
STRIPE_COMPLETE_PRICE_ID=

# HighLevel: Private Integration Token for the single Velxo sub-account.
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=

# Google Places API (New) — automatic Google Business Profile lookup in the
# onboarding wizard (src/lib/google/places.ts). Must have "Places API (New)"
# enabled (not the legacy Places API) in its Google Cloud project, with
# billing enabled. Server-only — never expose as a NEXT_PUBLIC_ variable.
GOOGLE_PLACES_API_KEY=

# Stripe's permanent, shareable Customer Portal login link
# (billing.stripe.com/p/login/...), copied from Settings -> Billing ->
# Customer portal in the Stripe Dashboard (test and live mode each have their
# own link). Public by design — customers verify their own identity via an
# emailed one-time code, so this is intentionally a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_STRIPE_PORTAL_URL=
